# Copy to .env and set DB_PASSWORD to a local-only secret before starting Compose.
POSTGRES_DB=smart_meeting_scheduler_docker
DB_USERNAME=scheduler
DB_PASSWORD=replace-with-a-local-secret

# The deterministic mock provider keeps the stack independent of external AI services.
AI_PROVIDER=mock
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_MODEL=
OPENAI_API_KEY=
